PORT=8080
NODE_ENV=development
MONGO_URL=your_mongodb_connection_string
JWT_SECRET=some_long_random_string

# frontend url, only needed if client is hosted separately
CLIENT_URL=http://localhost:3000

# razorpay test keys (dashboard.razorpay.com > settings > api keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# cloudinary product image cdn (optional - falls back to mongodb buffer if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# redis cache (optional - falls back to in-memory store if omitted)
REDIS_URL=redis://localhost:6379

# gmail + app password for the contact form
EMAIL_USER=
EMAIL_PASS=
